import numpy as np
from scipy.linalg import eigh
from scipy.optimize import minimize_scalar

def estimate_lambda_gcv(y, lam_min=1e0, lam_max=1e14):
    """
    Pick HP filter lambda by generalized cross validation.

    HP trend solves min ||y - t||^2 + lam * ||D2 t||^2,
    so t = (I + lam K)^-1 y with K = D2'D2.
    Eigendecompose K = Q diag(d) Q' once. Then
        tr S(lam)   = sum 1/(1 + lam d_i)
        ||y - t||^2 = sum (lam d_i / (1 + lam d_i))^2 z_i^2
    with z = Q'y. GCV over lambda becomes a cheap 1d problem.

    Returns the lambda minimizing GCV, clipped to [lam_min, lam_max].
    """
    y = np.asarray(y, dtype=float)
    n = len(y)
    if n < 10:
        raise ValueError("window too short")

    # second difference penalty K = D2'D2
    D = np.zeros((n - 2, n))
    for i in range(n - 2):
        D[i, i], D[i, i + 1], D[i, i + 2] = 1.0, -2.0, 1.0
    K = D.T @ D

    # one-time cost, O(n^3). fine for windows up to a few thousand.
    d, Q = eigh(K)
    d = np.clip(d, 0.0, None)   # kill tiny negative rounding noise
    z2 = (Q.T @ y) ** 2

    def gcv_log(loglam):
        lam = np.exp(loglam)
        a = lam * d / (1.0 + lam * d)      # residual factor per eigenmode
        rss = np.sum(a**2 * z2)
        df = np.sum(1.0 / (1.0 + lam * d))  # tr S(lam)
        denom = (n - df)
        if denom <= 0:
            return np.inf
        return n * rss / denom**2

    # coarse grid first so we don't get stuck in a flat region
    grid = np.linspace(np.log(lam_min), np.log(lam_max), 60)
    vals = [gcv_log(g) for g in grid]
    g0 = grid[int(np.argmin(vals))]

    # refine around the grid winner
    lo = max(np.log(lam_min), g0 - 1.0)
    hi = min(np.log(lam_max), g0 + 1.0)
    res = minimize_scalar(gcv_log, bounds=(lo, hi), method='bounded')

    return float(np.exp(res.x))

import numpy as np
from statsmodels.tsa.statespace.structural import UnobservedComponents

def estimate_lambda(y, lam_min=1e2, lam_max=1e12):
    """
    Estimate HP filter lambda from the data via ML.
    lambda = sigma2_cycle / sigma2_trend
    Clipped to [lam_min, lam_max] to keep short/noisy
    windows from producing crazy values.
    """
    y = np.asarray(y, dtype=float)
    if len(y) < 20:
        raise ValueError("window too short to estimate lambda reliably")

    mod = UnobservedComponents(y, level='lltrend')
    res = mod.fit(disp=False)
    p = dict(zip(res.param_names, res.params))

    s2_cycle = p['sigma2.irregular']
    s2_trend = p['sigma2.trend']

    if s2_trend <= 1e-12:
        return lam_max  # basically no trend variation, smooth hard

    return float(np.clip(s2_cycle / s2_trend, lam_min, lam_max))


def extract_two_trades(df_past_and_future_prices,
                       future_start=None,
                       peak_phase=90.0,
                       trough_phase=270.0):
    """
    Phase-momentum version, not buy-the-low / sell-the-high.

    Long trade : enter at the rising zero crossing of the wave
                 (max upward velocity), exit when phase reaches
                 the cycle peak (default 90 deg).
    Short trade: enter at the falling zero crossing, exit when
                 phase reaches the cycle trough (default 270 deg).

    Parameters
    ----------
    df_past_and_future_prices : DataFrame with columns
        ['Price', 'phase', 'wave']. Phase is assumed in degrees.
    future_start : index label or int position where the unseen
        (out of sample) part begins. Trades are only taken there.
        If None, the whole frame is used.
    Returns
    -------
    A copy of the input df containing only the rows that belong
    to the two trades, with these extra columns:
        trade_id, side, position, entry_price, exit_price, pnl
    """
    df = df_past_and_future_prices.copy()
    df["phase"] = np.mod(df["phase"], 360.0)

    # restrict signal generation to the unseen window
    if future_start is not None:
        if isinstance(future_start, int):
            live = df.index[future_start:]
        else:
            live = df.index[df.index.get_loc(future_start):]
    else:
        live = df.index

    wave = df["wave"]
    prev = wave.shift(1)

    long_entry = (prev <= 0) & (wave > 0)    # rising zero cross
    short_entry = (prev >= 0) & (wave < 0)   # falling zero cross

    def phase_reached(start_pos, target):
        """First bar at/after start_pos where phase passes target,
        handling the 360 wrap."""
        ph = df["phase"].to_numpy()
        for i in range(start_pos + 1, len(ph)):
            a, b = ph[i - 1], ph[i]
            if b < a:                       # wrapped past 360
                b += 360.0
                target_adj = target if target >= a else target + 360.0
            else:
                target_adj = target
            if a < target_adj <= b:
                return i
        return None

    trades = []
    for side, entries, exit_target in [
        ("long", long_entry, peak_phase),
        ("short", short_entry, trough_phase),
    ]:
        hits = df.index[entries & df.index.isin(live)]
        if len(hits) == 0:
            continue
        e_label = hits[0]
        e_pos = df.index.get_loc(e_label)
        x_pos = phase_reached(e_pos, exit_target)
        if x_pos is None:
            x_pos = len(df) - 1             # no exit found, close on last bar
        trades.append((side, e_pos, x_pos))

    # annotate and slice
    keep = np.zeros(len(df), dtype=bool)
    for col, default in [("trade_id", np.nan), ("side", None),
                         ("position", 0.0), ("entry_price", np.nan),
                         ("exit_price", np.nan), ("pnl", np.nan)]:
        df[col] = default

    for tid, (side, e, x) in enumerate(sorted(trades, key=lambda t: t[1]), 1):
        keep[e:x + 1] = True
        sign = 1.0 if side == "long" else -1.0
        ep = df["Price"].iloc[e]
        xp = df["Price"].iloc[x]
        rows = df.index[e:x + 1]
        df.loc[rows, "trade_id"] = tid
        df.loc[rows, "side"] = side
        df.loc[rows, "position"] = sign
        df.loc[rows, "entry_price"] = ep
        df.loc[rows, "exit_price"] = xp
        df.loc[rows, "pnl"] = sign * (xp - ep)

    return df.loc[keep].copy()
